[
    {
      "Key": "custom.top5.processes",
      "FileName": "powershell.exe",
      "Arguments": "-NoProfile -Command \"Get-Process | Sort-Object CPU -Descending | Select-Object -First 5 -ExpandProperty ProcessName\"",
      "TimeoutMs": 7000,
      "MaxOutputChars": 4000,
      "Enabled": true
    },
    {
      "Key": "custom.disk.c.free.gb",
      "FileName": "powershell.exe",
      "Arguments": "-NoProfile -Command \"[math]::Round((Get-PSDrive C).Free/1GB,2)\"",
      "TimeoutMs": 5000,
      "MaxOutputChars": 2000,
      "Enabled": true
    }
  ]