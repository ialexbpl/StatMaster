{
  "ConnectionStrings": {
  "StatMasterDb": "Data Source=statmaster.db"
},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "Port": 50001,
    "CertPath": "../../certs/statmaster-server.pfx",
    "CertPassword": "ChangeThisStrongPassword!",
    "ExpectedToken": "dev-token"
  },
  "MetricQuery": {
    "TimeoutMsPerMetric": 5000,
    "MaxRetries": 1,
    "RetryDelayMs": 300
  },


  "MetricCatalog": {
    "Items": [
      {
        "Key": "system.hostname",
        "Description": "Machine hostname",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 30
      },
      {
        "Key": "cpu.count",
        "Description": "Logical CPU count",
        "ValueType": "number",
        "Unit": "count",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 30
      },
      {
        "Key": "cpu.usage.percent",
        "Description": "Current CPU usage percentage",
        "ValueType": "number",
        "Unit": "%",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 30
      },
      {
        "Key": "os.description",
        "Description": "OS description",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 60
      },
      {
        "Key": "ram.total.mb",
        "Description": "Total physical RAM",
        "ValueType": "number",
        "Unit": "MB",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 60
      },
      {
        "Key": "ram.used.mb",
        "Description": "Used physical RAM",
        "ValueType": "number",
        "Unit": "MB",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 60
      },
      {
        "Key": "disk.total.gb",
        "Description": "Total system drive space",
        "ValueType": "number",
        "Unit": "GB",
        "Enabled": true,
        "Source": "built-in",
        "Target": "storage",
        "IntervalSeconds": 120
      },
      {
        "Key": "disk.free.gb",
        "Description": "Free system drive space",
        "ValueType": "number",
        "Unit": "GB",
        "Enabled": true,
        "Source": "built-in",
        "Target": "storage",
        "IntervalSeconds": 120
      },
      {
        "Key": "system.uptime",
        "Description": "System uptime since boot",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "built-in",
        "Target": "core",
        "IntervalSeconds": 60
      },
      {
        "Key": "custom.top5.processes",
        "Description": "Custom script: top 5 process names by CPU",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "script",
        "Target": "all",
        "IntervalSeconds": 120
      },
      {
        "Key": "custom.disk.c.free.gb",
        "Description": "Free space on C: from custom script",
        "ValueType": "number",
        "Unit": "GB",
        "Enabled": true,
        "Source": "script",
        "Target": "all",
        "IntervalSeconds": 120
      },
      {
        "Key": "custom.system.logs",
        "Description": "Windows Event Log snapshot (System + Application)",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "script",
        "Target": "all",
        "IntervalSeconds": 120
      },
      {
        "Key": "custom.sys.valdyslaw",
        "Description": "Windows Event Log snapshot (System + Application)",
        "ValueType": "string",
        "Unit": "",
        "Enabled": true,
        "Source": "script",
        "Target": "all",
        "IntervalSeconds": 120
      }
    ]
  }
}