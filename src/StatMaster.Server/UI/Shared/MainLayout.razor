@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-shell">
    <header class="top-nav top-nav-extended">
        <div class="container nav-row nav-row-main">
            <a class="brand" href="/" title="Dashboard">
                <img class="brand-logo" src="img/statmaster-logo.png" alt="StatMaster" />
            </a>

            <div class="nav-search">
                <input placeholder="Search agents..." />
            </div>

            <div class="nav-actions">
                <a class="icon-btn" title="Notifications" href="/notifications">!</a>

                <div class="account-menu-wrap">
                    <details class="account-menu-details">
                        <summary class="avatar-btn" title="@_username">@_initials</summary>
                        <div class="account-menu">
                            <a class="account-menu-item" href="/profile">Profile</a>
                            <form method="post" action="/auth/logout">
                                <button type="submit" class="account-menu-item">Logout</button>
                            </form>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </header>
    <main class="container page-body">
        @Body
    </main>
</div>

@code {
    private string _username = "admin";
    private string _initials = "AD";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string name = state.User.Identity?.Name ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(name))
            _username = name;

        _initials = _username.Trim().Length >= 2
            ? _username.Trim()[..2].ToUpperInvariant()
            : _username.Trim().ToUpperInvariant();
    }
}
