@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="top-nav top-nav-extended">
        <div class="container nav-row nav-row-main">
            <div class="brand" @onclick="@(() => Navigation.NavigateTo("/"))">StatMaster</div>

            <div class="nav-search">
                <input placeholder="Search agents..." />
            </div>

            <div class="nav-actions">
                <a class="icon-btn" title="Notifications" href="/notifications">!</a>

                <div class="account-menu-wrap">
                    <details class="account-menu-details">
                        <summary class="avatar-btn" title="Account">AD</summary>
                        <div class="account-menu">
                            <button type="button" class="account-menu-item">
                                Profile (coming soon)
                            </button>
                            <button type="button" class="account-menu-item">
                                Logout (coming soon)
                            </button>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </header>
    <main class="container page-body">
        @Body
    </main>
</div>
