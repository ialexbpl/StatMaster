@page "/change-password"
@attribute [Authorize]
@layout AuthLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="auth-card card">
    <h2>Change password</h2>
    <p class="muted">Set a new password before using the dashboard.</p>

    <EditForm Model="_model" OnValidSubmit="ChangeAsync">
        <div class="field">
            <label>Old password</label>
            <InputText @bind-Value="_model.OldPassword" type="password" />
        </div>
        <div class="field">
            <label>New password</label>
            <InputText @bind-Value="_model.NewPassword" type="password" />
        </div>
        <div class="field">
            <label>Confirm password</label>
            <InputText @bind-Value="_model.ConfirmPassword" type="password" />
        </div>
        <button class="btn-primary" type="submit">Update password</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="@(_isError ? "error-text" : "ok-text")">@_message</p>
    }
</div>

@code {
    private ChangePasswordModel _model = new();
    private string _message = string.Empty;
    private bool _isError;

    private async Task ChangeAsync()
    {
        _message = string.Empty;
        _isError = false;

        var result = await JS.InvokeAsync<ActionResult>(
            "statmasterAuth.changePassword",
            _model.OldPassword,
            _model.NewPassword,
            _model.ConfirmPassword);

        if (!result.ok)
        {
            _isError = true;
            _message = result.message ?? "Password change failed.";
            return;
        }

        _message = "Password changed successfully.";
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class ChangePasswordModel
    {
        public string OldPassword { get; set; } = "admin";
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class ActionResult
    {
        public bool ok { get; set; }
        public string? message { get; set; }
    }
}
